{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "预览：启动开发服务器并打开浏览器",
      "type": "shell",
      "command": "npm run dev -- --open",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "预览：构建并预览真实产物",
      "type": "shell",
      "command": "npm run build && npm run preview -- --open",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "预览：停止本地服务器",
      "type": "shell",
      "command": "npx astro dev stop",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "校验：构建（检查 frontmatter）",
      "type": "shell",
      "command": "npm run build",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    }
  ]
}
