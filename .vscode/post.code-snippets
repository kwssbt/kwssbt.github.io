{
  "新文章 frontmatter": {
    "scope": "markdown",
    "prefix": "post",
    "body": [
      "---",
      "title: ${1:}",
      "date: ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE} ${CURRENT_HOUR}:${CURRENT_MINUTE}",
      "description: ${2:}",
      "tags: [${3:}]",
      "draft: true",
      "---",
      "",
      "${0}"
    ],
    "description": "插入文章 frontmatter，时间自动填当前日期与时分"
  },
  "数学公式块": {
    "scope": "markdown",
    "prefix": "math",
    "body": ["$$", "${1}", "$$", "$0"],
    "description": "插入独立成行的公式块"
  }
}
